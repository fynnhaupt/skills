{
  "name": "@fynnhaupt/skills",
  "description": "My collection of agent skills I use every day.",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "claude",
    "claude-skills",
    "productivity",
    "workflow-automation"
  ],
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/fynnhaupt/skills"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "format": "prettier --check --ignore-unknown .",
    "format:fix": "prettier --write --ignore-unknown .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "*.{html,css,json,md,yml,yaml}": "prettier --check --ignore-unknown",
    "*.{ts,mts,cts,tsx,js,mjs,cjs,jsx}": "prettier --check --ignore-unknown"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0"
}
